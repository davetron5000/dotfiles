alias vi='vim'

function ls_alias() {
  if [ "${1}" == '-ltr' ]; then
    \ls -ltr "${@:2}"
  else
    eza "${@}"
  fi
}
if [ $(type -p eza) ]; then
  alias ls='ls_alias'
  export EZA_ICONS_AUTO=1
fi
if [ $(type -p bat) ]; then
  alias cat=bat
  export BAT_THEME=Dracula
else
  if [ $(type -p batcat) ]; then
    alias cat=batcat
    export BAT_THEME=Dracula
  fi
fi
