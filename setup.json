{
  "setup" : [
    {
      "name": "Alfred",
      "type": "manual",
      "url": "https://www.alfredapp.com"
    },
    {
      "name": "Docker",
      "type": "manual",
      "url": "https://www.docker.com/products/docker-desktop/"
    },
    {
      "name": "Fantastical",
      "type": "manual",
      "url": "https://flexibits.com/fantastical"
    },
    {
      "name": "XCode Command-line",
      "type": "shell",
      "command": "xcode-select --install",
      "test": "gcc --help"
    },
    {
      "name": "Homebrew",
      "type": "shell",
      "command": "/bin/bash -c \"$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)\"",
      "test": "brew help"
    },
    {
      "name": "git",
      "type": "homebrew",
      "package": "git"
    },
    {
      "name": "global git ignore",
      "type": "shell",
      "command": "git config --global core.excludesfile ~/.gitignore",
      "test": "ls `git config --global core.excludesfile`"
    },
    {
      "name": "Heroku CLI",
      "type": "homebrew",
      "package": "heroku/brew/heroku"
    },
    {
      "name": "coreutils",
      "type": "homebrew",
      "package": "coreutils"
    },
    {
      "name": "gpg",
      "type": "homebrew",
      "package": "gpg"
    },
    {
      "name": "Vim Packages",
      "type": "manual",
      "instructions": [
        "do update_packages in your vim yo"
      ]
    },
    {
      "name": "Clone Solarized Terminal Themes",
      "type": "shell",
      "command": "cd ~/Projects/Personal && git clone https://github.com/tomislav/osx-terminal.app-colors-solarized.git",
      "test": "ls ~/Projects/Personal/osx-terminal.app-colors-solarized"
    },
    {
      "name": "Solarized Terminal Themes",
      "type": "manual",
      "instructions": [
        "Open up your terminal and install the themes",
        "They have been cloned into ~/Projects/Personal"
      ]
    },
    {
      "name": "Source Code Pro Font",
      "type": "manual",
      "url": "https://www.fontsquirrel.com/fonts/source-code-pro"
    },
    {
      "name": "monofur Font",
      "type": "manual",
      "url": "https://www.dafont.com/monofur.font"
    },
    {
      "name": "Rufscript Font",
      "type": "manual",
      "url": "https://fontlibrary.org/en/font/rufscript"
    },
    {
      "name": "Inconsolata Font",
      "type": "manual",
      "url": "https://fonts.google.com/specimen/Inconsolata"
    },
    {
      "name": "tig",
      "type": "homebrew",
      "package": "tig"
    },
    {
      "name": "Graphviz",
      "type": "homebrew",
      "package": "graphviz"
    },
    {
      "name": "direnv",
      "type": "homebrew",
      "package": "direnv"
    },
    {
      "name": "ag",
      "type": "homebrew",
      "package": "the_silver_searcher"
    },
    {
      "name": "AWS CLI",
      "type": "homebrew",
      "package": "awscli"
    },
    {
      "name": "exiftool",
      "type": "homebrew",
      "package": "exiftool"
    },
    {
      "name": "imagemagick",
      "type": "homebrew",
      "package": "imagemagick"
    },
    {
      "name": "GitHub CLI",
      "type": "homebrew",
      "package": "gh"
    },
    {
      "name": "jq",
      "type": "homebrew",
      "package": "jq"
    },
    {
      "name": "terminal-notifier",
      "type": "homebrew",
      "package": "terminal-notifier"
    },
    {
      "name": "neovim",
      "type": "homebrew",
      "package": "neovim"
    },
    {
      "name": "git-lfs",
      "type": "homebrew",
      "package": "git-lfs"
    },
    {
      "name": "Hashicorp Brew Tap",
      "type": "shell",
      "command": "brew tap hashicorp/tap",
      "test": "brew tap | grep hashicorp"
    },
    {
      "name": "terraform",
      "type": "homebrew",
      "package": "hashicorp/tap/terraform"
    },
    {
      "name": "1password-cli",
      "type": "homebrew",
      "package": "1password-cli"
    },
    {
      "name": "Backblaze",
      "type": "manual",
      "url": "https://backblaze.com"
    },
    {
      "name": "Adobe Lightroom",
      "type": "manual",
      "url": "https://creativecloud.adobe.com/apps/download/lightroom?locale=en-US"
    },
    {
      "name": "monaspace fonts",
      "type": "manual",
      "url": "https://github.com/githubnext/monaspace#monaspace"
    },
    {
      "name": "VimR",
      "type": "manual",
      "url": "https://github.com/qvacua/vimr/releases"
    },
    {
      "name": "npm",
      "type": "homebrew",
      "package": "npm"
    },
    {
      "name": "tree",
      "type": "homebrew",
      "package": "tree"
    },
    {
      "name": "Dash",
      "type": "manual",
      "url": "https://kapeli.com/dash"
    },
    {
      "name": "Ghostty",
      "type": "manual",
      "url": "https://ghostty.org/download"
    },
    {
      "name": "jujitsu",
      "type": "homebrew",
      "package": "jj"
    },
    {
      "name": "neovide",
      "type": "homebrew",
      "package": "--cask neovide"
    }
  ]
}
